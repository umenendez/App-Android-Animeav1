{
  "manifest_version": 3,
  "name": "AnimeAV1 → Google Sheets Tracker",
  "version": "1.5.2",
  "description": "Registra y gestiona tu lista de anime sincronizada con Google Sheets",
  "key": "",
  "permissions": [
    "storage",
    "identity",
    "notifications"
  ],
  "host_permissions": [
    "https://animeav1.com/*",
    "https://cdn.animeav1.com/*",
    "https://*.animeflv.net/*",
    "https://sheets.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://animeav1.com/media/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "oauth2": {
    "client_id": "123415018434-v4tstmu50h3hvqda1q274ofn80phbmja.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  }
}
